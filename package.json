{
  "name": "pokedex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "validate:jp-sets": "node scripts/validate-japanese-supplement-sets.mjs",
    "prebuild": "node scripts/validate-japanese-supplement-sets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:seed": "node scripts/seed-pokemon-names-db.mjs",
    "db:seed:sets": "node scripts/seed-pokemon-sets-db.mjs",
    "db:export:sets-seed": "node scripts/export-pokemon-sets-seed.mjs",
    "db:seed:cards-index": "node scripts/seed-pokemon-cards-index.mjs",
    "db:seed:psa-pop": "node scripts/seed-psa-population.mjs",
    "validate:psa-pop": "node scripts/validate-psa-population.mjs",
    "db:seed:scan-index": "node scripts/seed-scan-index.mjs",
    "db:seed:scan-embeddings": "node scripts/seed-scan-embeddings.mjs",
    "db:seed:all": "npm run db:seed && npm run db:seed:sets && npm run db:seed:cards-index",
    "db:seed:official-jp-browse": "node scripts/seed-official-japanese-browse.mjs",
    "db:export:cards-cache": "node scripts/export-popular-cards-cache.mjs",
    "validate:sets": "node scripts/validate-set-prices.mjs",
    "validate:sets:smoke": "VALIDATE_MODE=smoke node scripts/validate-set-prices.mjs",
    "validate:sets:full": "VALIDATE_MODE=full VALIDATE_GRADING_MARKET=true node scripts/validate-set-prices.mjs",
    "validate:sets:exhaustive": "VALIDATE_MODE=exhaustive VALIDATE_LANG=all VALIDATE_GRADING_MARKET=true node scripts/validate-set-prices.mjs",
    "validate:sets:all-langs": "VALIDATE_MODE=exhaustive VALIDATE_LANG=all VALIDATE_GRADING_MARKET=true node scripts/validate-set-prices.mjs",
    "validate:fix-loop": "node scripts/validate-fix-loop.mjs",
    "validate:sets:strict": "VALIDATE_MODE=smoke VALIDATE_STRICT=true VALIDATE_INCLUDE_NUMBER_SORT=true node scripts/validate-set-prices.mjs",
    "validate:search": "node scripts/validate-search.mjs",
    "validate:grading": "node scripts/validate-grading-market.mjs",
    "validate:market": "node scripts/validate-market-accuracy.mjs",
    "validate:market:ja": "VALIDATE_LANG=ja node scripts/validate-market-accuracy.mjs",
    "validate:card-data": "node scripts/validate-card-data.mjs",
    "validate:card-data:filter": "node scripts/validate-card-data.mjs",
    "validate:card-data:sweep": "VALIDATE_SWEEP=true node scripts/validate-card-data.mjs",
    "validate:card-data:sweep:smoke": "VALIDATE_SWEEP=true VALIDATE_SWEEP_MAX_SETS=8 node scripts/validate-card-data.mjs",
    "validate:card-data:sweep:ja": "VALIDATE_SWEEP=true VALIDATE_SWEEP_LANG=ja node scripts/validate-card-data.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^12.10.0",
    "next": "16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.3"
  }
}
