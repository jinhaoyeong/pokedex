# Optional PostgreSQL database for catalog persistence, sold listings, and market cache
DATABASE_URL=postgresql://user:password@localhost:5432/pokepokedex

# Vercel Cron authorization for /api/cron/ingest
CRON_SECRET=replace-with-random-secret

# Optional paid PriceCharting API enrichment
PRICECHARTING_TOKEN=

# Set to false to disable in-memory market cache
MARKET_DATA_CACHE=true
