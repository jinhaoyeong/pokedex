# --- Portfolio foundation (Supabase + Clerk) ---
# Supabase Postgres connection strings.
# DATABASE_URL: the app connection — use the transaction pooler URL
# (port 6543, host *.pooler.supabase.com). Direct db.*.supabase.co:5432 is
# IPv6-only on free/pro without the IPv4 add-on and cannot be reached from Vercel.
# DIRECT_URL: the direct connection (port 5432) — used automatically by
# migrations (`npm run db:migrate` / `npm run db:push`); falls back to
# DATABASE_URL when unset.
DATABASE_URL=
DIRECT_URL=

# Clerk authentication. Without these keys the app runs exactly as before:
# public search/pricing stays available and /portfolio/vault shows a setup notice.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Required by /api/webhooks/clerk. Copy the Signing Secret from the Clerk
# webhook endpoint subscribed to user.created.
CLERK_WEBHOOK_SIGNING_SECRET=

# PriceCharting official API (optional)
# Docs: https://www.pricecharting.com/api-documentation
# Authentication is the static subscription token passed as the `t` query parameter.
PRICECHARTING_API_KEY=
PRICECHARTING_API_TOKEN=
PRICECHARTING_BASE_URL=https://www.pricecharting.com
PRICECHARTING_API_BASE_URL=https://www.pricecharting.com/api
PRICECHARTING_API_TIMEOUT_MS=10000
PRICECHARTING_API_MIN_INTERVAL_MS=1100

# Free public-page mode
# Used automatically when no PriceCharting API key/token is configured. It uses a
# normal HTTP request, respects 403/Cloudflare blocks, and caches successful page
# parses for 24h so the app does not repeatedly fetch the same card.
PRICECHARTING_PUBLIC_CACHE_TTL_MS=86400000
OPEN_SOURCE_MARKET_CACHE_TTL_MS=86400000
POKEMONTCG_API_KEY=

# Optional provider-template aliases for the generic population endpoint adapters.
# The native PriceCharting provider does not require these, but these are the exact
# mappings if you want the generic DI adapters to call the same approved endpoint.
# PSA_POPULATION_ENDPOINT_TEMPLATE=https://www.pricecharting.com/api/product?t={priceChartingToken}&q={priceChartingQuery}
# CGC_POPULATION_ENDPOINT_TEMPLATE=https://www.pricecharting.com/api/product?t={priceChartingToken}&q={priceChartingQuery}
# BGS_POPULATION_ENDPOINT_TEMPLATE=https://www.pricecharting.com/api/product?t={priceChartingToken}&q={priceChartingQuery}

# Optional Beckett fallback source. Use an approved provider such as a private
# Apify actor or RapidAPI endpoint that returns JSON population counts. When set,
# the population orchestrator will merge it with the PriceCharting BGS result and
# keep whichever BGS snapshot has stronger grade coverage.
# BGS_POPULATION_API_URL=https://your-approved-bgs-source.example/population
# BGS_POPULATION_ENDPOINT_TEMPLATE=https://your-approved-bgs-source.example/population?set={setName}&card={cardName}&number={collectorNumber}&lang={language}
